{
  "name": "body-simulator-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8089",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "start": "next start -p 8089",
    "lint": "tsc --noEmit",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:cloudflare:ci": "OPEN_NEXT_DEPLOY=true wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "decimal.js": "^10.6.0",
    "next": "^15.5.9",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2",
    "wrangler": "^4.130.0"
  },
  "engines": {
    "node": ">=22"
  }
}
